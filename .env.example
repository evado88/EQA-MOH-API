# Configuration template for the EQA MOH API.
# Copy to .env and fill in real values:  cp .env.example .env
# Values already set in the real environment always override .env.
# Anything left unset falls back to the in-code default where one exists.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/moheqa
# true logs every SQL statement; false keeps output quiet
DB_ECHO=false
# connection pooling. Leave unset for pooling with a pre-ping liveness check
# (fine for single-process uvicorn). Set DB_POOL=null to disable pooling (one
# fresh connection per request) when running under a forking server such as
# gunicorn with multiple workers / --preload, or behind a transaction-mode
# PgBouncer. Fixes "asyncpg InterfaceError: connection is closed".
# DB_POOL=null

# --- Web / CORS -------------------------------------------------------------
# comma-separated list of browser origins allowed to call the API. On the
# single-domain server the frontend and API share an origin so CORS is not
# strictly needed, but set it to the public URL anyway (no trailing slash):
# CORS_ORIGINS=https://eqa.ims-zm.online
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth / JWT -------------------------------------------------------------
# REQUIRED in any shared/production setting. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256

# --- Locale -----------------------------------------------------------------
CURRENT_TIME_ZONE=Africa/Lusaka

# --- Email (Gmail SMTP) -----------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
# Gmail app password (a live credential). With this unset, email sending is
# skipped and the verification link is printed to the console instead.
MAIL_PASSWORD=
MAIL_FROM_NAME=Zambia EQA Platform
MAIL_USE_TLS=1
# the public frontend URL, used to build verification links. On the server:
# MAIL_APP_BASE_URL=https://eqa.ims-zm.online
MAIL_APP_BASE_URL=http://localhost:5173
# "1" skips the real SMTP send (useful in dev/offline and tests)
MAIL_SUPPRESS_SEND=1

# --- WhatsApp (Infobip) -----------------------------------------------------
INFOBIP_API_URL=https://your-base.api.infobip.com/whatsapp/1/message/template
# live API token - leave blank unless WhatsApp sending is configured
INFOBIP_API_TOKEN=
INFOBIP_PHONE_NUMBER=

# --- Dev tools --------------------------------------------------------------
# 1 enables the PT-cycle phase-jump testing endpoint; set 0 in production
ENABLE_DEV_TOOLS=0
