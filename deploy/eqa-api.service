# systemd unit for the EQA FastAPI/uvicorn service.
#
# Install:
#   sudo cp deploy/eqa-api.service /etc/systemd/system/eqa-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now eqa-api
#   sudo systemctl status eqa-api      # check it is running
#   journalctl -u eqa-api -f           # follow logs
#
# Adjust User/paths to match where you cloned the repo and created the venv.
#
# NOTE ON WORKERS: this runs a single async worker, which handles many
# concurrent (I/O-bound) users and keeps the daily reminder scheduler running
# in one place. If you later raise --workers above 1, set RUN_SCHEDULER=0 in
# this service's environment and run exactly one separate process with
# RUN_SCHEDULER=1, so reminder emails are not sent once per worker.

[Unit]
Description=EQA MOH API (FastAPI/uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=eqa
Group=eqa
WorkingDirectory=/opt/eqa/EQA-MOH-API
# .env in WorkingDirectory is loaded automatically by helpers/env.py
# port 8553 on this VPS (8800, the local-dev default, is used by another app)
ExecStart=/opt/eqa/EQA-MOH-API/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8553 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
